# Neon PostgreSQL Database Configuration
# Copy this file to .env.local and replace with your actual credentials

# Main database connection URL
DATABASE_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-lucky-leaf-abc8apus-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Prisma-compatible URL with connection pooling
POSTGRES_PRISMA_URL="postgresql://neondb_owner:YOUR_PASSWORD@ep-lucky-leaf-abc8apus-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"

# Direct connection URL (non-pooling)
POSTGRES_URL_NON_POOLING="postgresql://neondb_owner:YOUR_PASSWORD@ep-lucky-leaf-abc8apus-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require"

# Stack Auth Configuration (integrated with Neon)
STACK_AUTH_PROJECT_ID="bea8c741-74de-460a-af36-e771ef0eb5eb"
STACK_AUTH_JWKS_URL="https://api.stack-auth.com/api/v1/projects/bea8c741-74de-460a-af36-e771ef0eb5eb/.well-known/jwks.json"

